{
  "installCommand": "cd ../.. && node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));p.workspaces=['apps/api','packages/*'];fs.writeFileSync('package.json',JSON.stringify(p,null,2));\" && npm install",
